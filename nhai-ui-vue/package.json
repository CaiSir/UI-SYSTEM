{
  "name": "nhai-ui-vue",
  "version": "1.0.0",
  "description": "Vue 3 + Element Plus Component Library for NHAI Framework",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:typecheck": "vue-tsc --noEmit",
    "build:watch": "vite build --watch",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "element-plus",
    "component-library",
    "nhai"
  ],
  "author": "NHAI Team",
  "license": "MIT",
  "dependencies": {
    "@codemirror/lint": "^6.9.2",
    "element-plus": "^2.8.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "acorn": "^8.15.0",
    "codemirror": "^6.0.2",
    "codemirror-editor-vue3": "^2.8.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^1.8.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
